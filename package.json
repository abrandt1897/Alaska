{
  "name": "alaska-2026-planner",
  "private": true,
  "version": "1.0.0",
  "description": "A single-file, client-only trip planner for a 2026 Alaska trip.",
  "type": "commonjs",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{html,js,css,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{html,js,css,json}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.19.0",
    "eslint-plugin-html": "^8.1.2",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vitest": "^3.0.4"
  }
}
