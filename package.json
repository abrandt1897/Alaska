{
  "name": "alaska-2026-planner",
  "private": true,
  "version": "1.0.0",
  "description": "A single-file, client-only trip planner for a 2026 Alaska trip.",
  "type": "commonjs",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{html,js,css,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{html,js,css,json}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-html": "^8.1.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
